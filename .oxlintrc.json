{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "main.js"],
  "env": {
    "browser": true
  },
  "globals": {
    "NodeJS": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "off",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  }
}

{
  "name": "feishu-diary",
  "version": "0.2.5",
  "description": "Talk to a Feishu bot, and it lands in your Obsidian vault (or any local dir via the npx CLI) as a diary.",
  "keywords": [
    "cli",
    "diary",
    "feishu",
    "lark",
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/obsidian-feishu-diary.git"
  },
  "bin": {
    "feishu-diary": "dist/cli.cjs"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "dist/cli.cjs",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "oxlint",
    "lint:obsidian": "eslint src/",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test \"tests/*.test.ts\"",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "p0:init": "node scripts/p0/init.ts",
    "p0:diag": "node --env-file=scripts/p0/.env scripts/p0/diag.ts",
    "p0": "node --env-file=scripts/p0/.env scripts/p0/run.ts",
    "p0:debug": "FEISHU_DEBUG=1 node --env-file=scripts/p0/.env scripts/p0/run.ts",
    "p0:asr": "node --env-file=scripts/p0/.env scripts/p0/asr-probe.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.25.12",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.11.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.24.0"
}
